{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.5.0",
  "identifier": "app.prism.photo",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prism",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: prismsync: http://prismsync.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost prismsync: http://prismsync.localhost data: blob: https://api.github.com",
        "media-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Photography",
    "shortDescription": "Retouche photo",
    "copyright": "Draconix",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "onnxruntime/*": "onnxruntime/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QzEzQjVCNzQxRTVBMkQKUldRdFdoNTBXenZCYUQrdnNyblhMRlRwOEIwMG9aOFJLVmsxL0h4NU5BUzkvL0Mvb211d1BtQ2YK",
      "endpoints": [
        "https://github.com/Asmodeus-73/Prism/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
